{
  "name": "Reservation",
  "type": "object",
  "properties": {
    "occupant_name": {
      "type": "string",
      "description": "Occupant name"
    },
    "occupant_phone": {
      "type": "string",
      "description": "Occupant phone number"
    },
    "occupant_type": {
      "type": "string",
      "enum": [
        "man",
        "woman",
        "couple",
        "family"
      ],
      "default": "man"
    },
    "room_id": {
      "type": "string",
      "description": "Reserved room ID"
    },
    "room_number": {
      "type": "string",
      "description": "Room number"
    },
    "building_name": {
      "type": "string"
    },
    "site_name": {
      "type": "string"
    },
    "check_in_date": {
      "type": "string",
      "format": "date"
    },
    "check_out_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "canceled"
      ],
      "default": "pending"
    },
    "is_married_couple": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "occupant_name",
    "room_id",
    "check_in_date",
    "check_out_date"
  ]
}